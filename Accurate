.2),\n","])\n","\n","input_shape = (IMAGE_SIZE, IMAGE_SIZE, CHANNELS)\n","n_classes = 5\n","\n","def conv_block(filters):\n","  return tf.keras.Sequential([\n","      layers.Conv2D(filters, (3,3), padding='same', use_bias=False),\n","      layers.BatchNormalization(), layers.ReLU(),\n","      layers.MaxPooling2D((2,2))\n","      ])\n","\n","model = models.Sequential([\n","      layers.Input(shape=input_shape),\n","      resize_and_rescale,\n","      data_augmentation,\n","\n","      conv_block(32),\n","      conv_block(64),\n","      conv_block(128),\n","      conv_block(256),\n","\n","      layers.GlobalAveragePooling2D(),\n","      layers.Dense(256, activation='relu'),\n","      layers.Dropout(0.4),\n","      layers.Dense(n_classes, activation='softmax') ])\n","\n","optimizer=tf.keras.optimizers.Adam(1e-4)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"wm-uZPDWqlR9","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1772543093384,"user_tz":0,"elapsed":211474,"user":{"displayName":"Afia Parveen","userId":"13956359562104072757"}},"outputId":"f47b2a33-bba2-4a86-d350-5499635b0758"},"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 1/80\n","\u001b[1m15/15\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m16s\u001b[0m 321ms/step - accuracy: 0.6051 - loss: 1.0413 - val_accuracy: 0.2812 - val_loss: 1.5523\n","Epoch 2/80\n","\u001b[1m15/15\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 157ms/step - accuracy: 0.8881 - loss: 0.3152 - val_accuracy: 0.3125 - val_loss: 1.7268\n","Epoch 3/80\n","\u001b[1m15/15\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 155ms/step - accuracy: 0.9115 - loss: 0.2507 - val_accuracy: 0.3125 - val_loss: 2.5090\n","Epoch 4/80\n","\u001b[1m15/15\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2s\u001b[0m 155ms/step - accuracy: 